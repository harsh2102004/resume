# Server Configuration
PORT=8000
NODE_ENV=development
# Comma-separated list of allowed CORS origins (e.g. http://localhost:5173,https://app.example.com)
# REQUIRED in production — must not be "*". Wildcard is allowed only in development.
CORS_ORIGIN=http://localhost:5173

# Database & Caching
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net
REDIS_URL=redis://localhost:6379

# JWT Authentication
ACCESS_TOKEN_SECRET=your_access_token_secret_here
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
REFRESH_TOKEN_EXPIRY=10d

# Media Security & Streaming
STREAM_SECRET=your_stream_hmac_secret_here_required_in_production
ENFORCE_SIGNED_STREAMS=false
UPLOAD_DIR=storage/uploads/resumable

# Cloudinary CDN (Optional / Fallback)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=