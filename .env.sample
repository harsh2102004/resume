# Server Configuration
# Application HTTP server listening port
PORT=8000

# Application execution environment ('development', 'test', 'production')
NODE_ENV=development

# Comma-separated list of allowed CORS origins (e.g. http://localhost:5173,https://app.example.com)
# REQUIRED in production — wildcard "*" is rejected at startup in production
CORS_ORIGIN=http://localhost:5173

# Database & Caching
# MongoDB connection URI (e.g. Atlas connection string or mongodb://localhost:27017)
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net

# Optional custom database name (defaults to 'pulsecast')
DB_NAME=pulsecast

# Redis connection URL for BullMQ video transcoding queue
REDIS_URL=redis://localhost:6379

# JWT Authentication
# Secret key used to sign and verify short-lived access tokens
ACCESS_TOKEN_SECRET=your_access_token_secret_here

# Access token expiry duration (e.g. 15m, 1d)
ACCESS_TOKEN_EXPIRY=1d

# Secret key used to sign and verify long-lived refresh tokens
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

# Refresh token expiry duration (e.g. 7d, 10d)
REFRESH_TOKEN_EXPIRY=10d

# Media Security & Streaming
# HMAC secret used to sign and verify secure time-limited stream tokens (REQUIRED in production)
STREAM_SECRET=your_stream_hmac_secret_here_required_in_production

# Optional fallback secret for development and test environments only
TEST_STREAM_SECRET=dev_test_stream_secret_only

# Enforce signed streaming token verification for all published media (true/false)
ENFORCE_SIGNED_STREAMS=false

# Local filesystem directory where original resumable video uploads are staged
UPLOAD_DIR=storage/uploads/resumable

# Optional path to a TrueType font file on disk for FFmpeg video watermark overlay
WATERMARK_FONT=

# Cloudinary CDN (Optional - falls back to local storage and chunked streaming if omitted)
# Cloudinary cloud namespace
CLOUDINARY_CLOUD_NAME=

# Cloudinary API credential key
CLOUDINARY_API_KEY=

# Cloudinary API credential secret
CLOUDINARY_API_SECRET=
